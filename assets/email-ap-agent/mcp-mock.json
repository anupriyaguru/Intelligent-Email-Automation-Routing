    "email-connector": {
      "mcp_server_name": "email.connector/outlook_gmail",
      "description": "MCP server for email operations - send replies via Outlook and Gmail",
      "tools": {
        "send_email": {
          "description": "Send an email reply via Outlook or Gmail",
          "input_schema": {
            "type": "object",
            "properties": {
              "to": {
                "type": "string",
                "description": "Recipient email address"
              },
              "subject": {
                "type": "string",
                "description": "Email subject"
              },
              "body": {
                "type": "string",
                "description": "Email body (HTML or plain text)"
              },
              "channel": {
                "type": "string",
                "description": "Email channel: outlook or gmail"
              },
              "case_id": {
                "type": "string",
                "description": "Case ID for tracking"
              }
            },
            "required": ["to", "subject", "body", "channel"]
          },
          "mock_response": {
            "status": "sent",
            "message_id": "MSG-2026-07-28-001",
            "sent_at": "2026-07-28T10:30:00Z",
            "channel": "outlook",
            "recipient": "vendor@supplierco.com"
          }
        }
      }
    }
