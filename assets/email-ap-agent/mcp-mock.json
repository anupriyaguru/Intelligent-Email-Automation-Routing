      "tools": {
        "get_supplier_invoice": {
          "description": "Retrieve supplier invoice details by invoice number",
          "input_schema": {
            "type": "object",
            "properties": {
              "invoice_number": {
                "type": "string",
                "description": "Supplier invoice number"
              }
            },
            "required": ["invoice_number"]
          },
          "mock_response": {
            "SupplierInvoice": "INV-2026-12345",
            "FiscalYear": "2026",
            "CompanyCode": "1000",
            "SupplierName": "SupplierCo Inc.",
            "InvoiceGrossAmount": "15000.00",
