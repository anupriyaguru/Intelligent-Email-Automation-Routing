              "supplier_id": {
                "type": "string",
                "description": "Filter by supplier/vendor ID"
              },
              "company_code": {
                "type": "string",
                "description": "Company code"
              },
              "fiscal_year": {
                "type": "string",
                "description": "Fiscal year"
              },
              "top": {
                "type": "string",
                "description": "Maximum number of records to return"
              }
            },
            "required": []
          },
          "mock_response": {
            "results": [
              {
                "SupplierInvoice": "INV-2026-12345",
                "FiscalYear": "2026",
