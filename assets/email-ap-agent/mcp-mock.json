            "AccountingDocumentType": "KR",
            "PaymentBlockingReason": "",
            "PaymentStatus": "Paid",
            "PaymentDate": "2026-07-25",
            "PaymentAmount": "15000.00",
            "DueDate": "2026-08-14"
          }
        },
